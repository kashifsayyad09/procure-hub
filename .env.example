# Copy to .env and set real values. Never commit .env.
# Docker Compose treats $ in .env values as a variable. If a value contains $, wrap it in single quotes.
# The database password must not contain single or double quotes or backslashes.
# Local development only; production secrets come from AWS Secrets Manager.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306

# Authentication service
AUTH_DB_PASSWORD=change-me-auth-db

# Purchase request service
PURCHASE_REQUEST_DB_PASSWORD=change-me-purchase-request-db

# Approval service
APPROVAL_DB_PASSWORD=change-me-approval-db

# Vendor service
VENDOR_DB_PASSWORD=change-me-vendor-db

# Quotation service (RFQs and quotations)
QUOTATION_DB_PASSWORD=change-me-quotation-db

# Signs calls between services (not user tokens). Use a different value from JWT_SECRET, at least 32 characters.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_JWT_SECRET=change-me-generate-another-long-random-secret

# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"  (at least 32 characters)
JWT_SECRET=change-me-generate-a-long-random-secret
