# Copy to .env and set real values. Never commit .env.
# Local development only; production secrets come from AWS Secrets Manager.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306

# Authentication service
AUTH_DB_PASSWORD=change-me-auth-db
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"  (at least 32 characters)
JWT_SECRET=change-me-generate-a-long-random-secret
